DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=agent_platform
POSTGRES_USER=agent_platform
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432
REDIS_PORT=56379

DATABASE_URL=postgres://agent_platform:change-me@127.0.0.1:55432/agent_platform
REDIS_URL=redis://127.0.0.1:56379/0

TENANT_RATE_LIMIT=120/min
ALLOWED_MODELS=gpt-4o-mini,gpt-4o

LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
RUN_TIMEOUT_SECONDS=60
RUN_MAX_RETRIES=3
RUN_RETRY_BACKOFF_SECONDS=2

EMBEDDER=hashing
MAX_DOCUMENT_BYTES=1048576
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.1

TOOL_ALLOWED_DOMAINS=
TOOL_TIMEOUT_SECONDS=10
TOOL_MAX_RESPONSE_BYTES=65536
MAX_TOOL_STEPS=5

LANGFUSE_PORT=24300
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
